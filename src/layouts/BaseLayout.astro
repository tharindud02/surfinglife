---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import BookingModal from "../components/BookingModal.astro";
import WhatsappFab from "../components/WhatsappFab.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Exact optimized hero URL for LCP preload (homepage only). */
  lcpImageSrc?: string;
}

const { title, description, lcpImageSrc } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/images/Banner/banner-image-surf.png", Astro.site);
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="canonical" href={canonicalURL} />

    <title>{title}</title>
    <meta name="description" content={description} />

    {
      lcpImageSrc && (
        <link
          rel="preload"
          as="image"
          href={lcpImageSrc}
          type="image/webp"
          fetchpriority="high"
        />
      )
    }

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <Navbar />
    <slot />
    <WhatsappFab />
    <Footer />
    <BookingModal />

    <script>
      import "../scripts/reveal";
    </script>

    <!-- Analytics only on real deploys — skip localhost preview (avoids 404 noise) -->
    <script>
      if (import.meta.env.PROD) {
        const host = window.location.hostname;
        const isLocal = host === "localhost" || host === "127.0.0.1";
        if (!isLocal) {
          const loadAnalytics = async () => {
            const { inject } = await import("@vercel/analytics");
            const { injectSpeedInsights } = await import("@vercel/speed-insights");
            inject();
            injectSpeedInsights();
          };

          const schedule =
            "requestIdleCallback" in window
              ? (cb: () => void) => window.requestIdleCallback(cb, { timeout: 4000 })
              : (cb: () => void) => window.setTimeout(cb, 2000);

          schedule(() => {
            void loadAnalytics();
          });
        }
      }
    </script>
  </body>
</html>
