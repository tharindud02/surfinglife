---
import { Image } from "astro:assets";
import heroImage from "../assets/banner/banner-image-surf.png";
import loveIcon from "../assets/banner/icons/love.png";
import moneyIcon from "../assets/banner/icons/money.png";
import beachIcon from "../assets/banner/icons/beach.png";
import staffIcon from "../assets/banner/icons/staff1.png";
import type { ImageMetadata } from "astro";

const highlights: { icon: ImageMetadata; text: string; top: string }[] = [
  {
    icon: loveIcon,
    text: "8 elegantly styled rooms,<br /> including deluxe AC suites.",
    top: "top-24",
  },
  {
    icon: moneyIcon,
    text: "Two restaurants for every <br />mood, from casual to fine dining.",
    top: "top-48",
  },
  {
    icon: beachIcon,
    text: "Minutes from Coconut Beach and <br /> Weligama's best surf breaks.",
    top: "top-72",
  },
  {
    icon: staffIcon,
    text: "Attentive, personalized service <br /> throughout your stay.",
    top: "top-96",
  },
];
---

<div id="home-section" class="bg-lightpink">
  <div class="grid grid-cols-1 lg:grid-cols-2 lg:items-center">
    <div class="px-6 py-16 lg:py-0 lg:pl-[max(1.5rem,calc((100vw-80rem)/2+1.5rem))] lg:pr-12">
      <p class="text-ink text-sm font-semibold mb-4 ls-51 uppercase lg:text-start text-center">
        Weligama, Sri Lanka
      </p>
      <h1 class="text-4xl lg:text-6xl font-serif font-semibold mb-5 text-lightgrey lg:text-start text-center">
        Modern Luxury,<br />Steps from the Sea
      </h1>
      <p class="text-lightgrey/80 lg:text-lg font-normal mb-10 lg:text-start text-center pr-4">
        Surfing Life Guest House has been reimagined into a refined boutique retreat near Coconut Beach. Eight
        thoughtfully designed rooms, two distinct restaurants, and effortless hospitality await — an elevated
        stay for surfers and travelers alike.
      </p>
      <div class="md:flex align-middle justify-center lg:justify-start">
        <a
          href="#rooms-section"
          class="text-lg w-full md:w-auto font-semibold rounded-full text-white py-4 px-8 bg-ink lg:px-10 mr-6 inline-block text-center"
        >
          View Rooms
        </a>
        <a
          href="#cook-section"
          class="flex border w-full md:w-auto mt-5 md:mt-0 border-ink justify-center rounded-full text-lg font-medium items-center py-4 px-10 text-lightgrey hover:text-white hover:bg-ink hover:border-ink"
        >
          Our Restaurants
        </a>
      </div>
    </div>

    <div class="relative pb-16 lg:pb-0">
      {
        highlights.map((item) => (
          <div
            class:list={[
              "hidden lg:flex bg-white p-2 gap-5 items-center left-4 rounded-xl absolute z-10 shadow-sm",
              item.top,
            ]}
          >
            <Image
              src={item.icon}
              alt=""
              widths={[40, 80]}
              sizes="40px"
              width={40}
              height={40}
              format="webp"
              quality={70}
              loading="lazy"
              decoding="async"
              class="w-10 h-10 object-contain"
              aria-hidden="true"
            />
            <p class="text-lg font-normal text-lightgrey" set:html={item.text} />
          </div>
        ))
      }

      <Image
        src={heroImage}
        alt="Surfing Life Guest House near Coconut Beach, Weligama"
        widths={[640, 800, 1000, 1280]}
        sizes="(max-width: 1024px) 100vw, 50vw"
        width={800}
        height={644}
        format="webp"
        quality={72}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="w-full h-auto object-cover lg:rounded-l-[3rem]"
      />
    </div>
  </div>
</div>
