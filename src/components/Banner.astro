---
import { Image } from "astro:assets";
import Reveal from "./Reveal.astro";
import heroImage from "../assets/banner/banner-image-surf.png";
---

<div id="home-section" class="bg-lightpink">
  <div class="grid grid-cols-1 lg:grid-cols-2 lg:items-center">
    <div class="px-6 py-16 lg:py-0 lg:pl-[max(1.5rem,calc((100vw-80rem)/2+1.5rem))] lg:pr-12">
      <Reveal direction="up" delay={400}>
        <h2 class="text-pink text-sm font-medium mb-4 ls-51 uppercase lg:text-start text-center">
          Weligama, Sri Lanka
        </h2>
        <h1 class="text-4xl lg:text-6xl font-serif font-semibold mb-5 text-lightgrey lg:text-start text-center">
          Modern Luxury,<br />Steps from the Sea
        </h1>
      </Reveal>
      <Reveal direction="up" delay={800}>
        <p class="text-grey lg:text-lg font-normal mb-10 lg:text-start text-center pr-4">
          Surfing Life Guest House has been reimagined into a refined boutique retreat near Coconut Beach. Eight
          thoughtfully designed rooms, two distinct restaurants, and effortless hospitality await — an elevated
          stay for surfers and travelers alike.
        </p>
      </Reveal>
      <Reveal direction="up" delay={1000}>
        <div class="md:flex align-middle justify-center lg:justify-start">
          <a
            href="#rooms-section"
            class="text-lg w-full md:w-auto font-medium rounded-full text-white py-4 px-8 bg-pink lg:px-10 mr-6 inline-block text-center"
          >
            View Rooms
          </a>
          <a
            href="#cook-section"
            class="flex border w-full md:w-auto mt-5 md:mt-0 border-pink justify-center rounded-full text-lg font-medium items-center py-4 px-10 text-pink hover:text-white hover:bg-pink"
          >
            Our Restaurants
          </a>
        </div>
      </Reveal>
    </div>

    <div class="relative pb-16 lg:pb-0">
      <div class="flex bg-white p-2 gap-5 items-center top-24 left-4 rounded-xl absolute">
        <img src="/images/Banner/love.png" alt="" width="48" height="48" />
        <p class="text-lg font-normal text-darkgrey">8 elegantly styled rooms,<br /> including deluxe AC suites.</p>
      </div>
      <div class="flex bg-white p-2 gap-5 items-center top-48 left-4 rounded-xl absolute">
        <img src="/images/Banner/money.png" alt="" width="48" height="48" />
        <p class="text-lg font-normal text-darkgrey">Two restaurants for every <br />mood, from casual to fine dining.</p>
      </div>
      <div class="flex bg-white p-2 gap-5 items-center top-72 left-4 rounded-xl absolute">
        <img src="/images/Banner/beach.png" alt="" width="48" height="48" />
        <p class="text-lg font-normal text-darkgrey">Minutes from Coconut Beach and <br /> Weligama's best surf breaks.</p>
      </div>
      <div class="flex bg-white p-2 gap-5 items-center top-96 left-4 rounded-xl absolute">
        <img src="/images/Banner/staff1.png" alt="" width="48" height="48" />
        <p class="text-lg font-normal text-darkgrey">Attentive, personalized service <br /> throughout your stay.</p>
      </div>

      <Image
        src={heroImage}
        alt="Surfing Life Guest House"
        width={1000}
        height={805}
        loading="eager"
        fetchpriority="high"
        class="w-full h-auto object-cover lg:rounded-l-[3rem]"
      />
    </div>
  </div>
</div>
