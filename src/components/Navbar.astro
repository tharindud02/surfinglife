---
import { Image } from "astro:assets";
import logo from "../assets/logo/logo.png";
import MobileDrawer from "./MobileDrawer.astro";

const navigation = [
  { name: "Home", href: "/#home-section" },
  { name: "About us", href: "/#about-section" },
  { name: "Rooms", href: "/#rooms-section" },
  { name: "Restaurants", href: "/#cook-section" },
  { name: "Gallery", href: "/#gallery-section" },
  { name: "Events", href: "/#events-section" },
];
---

<nav class="navbar relative z-30 overflow-visible">
  <div class="navbar-old-shell mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 overflow-visible">
    <div class="navbar-old relative flex items-center overflow-visible">
      <div class="flex flex-1 items-center sm:justify-between gap-3 overflow-visible">
        <!-- Overlapping logo badge -->
        <a href="/" class="navbar-old-logo flex flex-shrink-0 items-center gap-3 group">
          <Image
            src={logo}
            alt="Surfing Life"
            widths={[88, 112, 144]}
            sizes="(max-width: 640px) 72px, 96px"
            width={96}
            height={96}
            format="webp"
            quality={90}
            loading="eager"
            decoding="async"
            class="navbar-old-logo__img"
          />
          <span class="hidden sm:block">
            <span class="block text-xl sm:text-2xl font-semibold text-black leading-tight group-hover:text-pink transition-colors">
              Surfing Life
            </span>
            <span class="block text-xs sm:text-sm font-medium text-grey leading-snug">
              Guest House &amp; Restaurant
            </span>
          </span>
        </a>

        <!-- LINKS -->
        <div class="hidden lg:flex items-center">
          <div class="flex justify-end space-x-4">
            {
              navigation.map((item) => (
                <a
                  href={item.href}
                  class="navlinks px-3 py-2 rounded-md text-lg font-normal opacity-50 hover:opacity-100 hover:text-black space-links"
                >
                  {item.name}
                </a>
              ))
            }
          </div>
        </div>
        <div class="gap-6 hidden lg:flex">
          <button
            data-book-trigger
            data-room-type="Room"
            class="flex justify-end text-sm font-medium bg-pink text-white py-3 px-6 lg:px-8 rounded-full hover:bg-pink/40 transition-all duration-300 ease-in-out"
          >
            Book Now
          </button>
        </div>
      </div>

      <!-- HAMBURGER (mobile) -->
      <div class="block lg:hidden shrink-0">
        <button id="drawer-trigger" aria-label="Open menu" class="p-2 -mr-1">
          <svg xmlns="http://www.w3.org/2000/svg" class="block h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</nav>

<MobileDrawer />

<style>
  /*
    Thin link row + taller logo. Extra top/bottom padding keeps the full
    circle inside the nav box so nothing is clipped by the viewport edge.
  */
  .navbar-old-shell {
    padding-top: 1.15rem;
    padding-bottom: 1.15rem;
    overflow: visible;
  }

  .navbar-old {
    min-height: 3.25rem;
    overflow: visible;
  }

  .navbar-old-logo {
    position: relative;
    z-index: 20;
  }

  .navbar-old-logo__img {
    display: block;
    width: 4.5rem;
    height: 4.5rem;
    max-width: none;
    object-fit: contain;
    border-radius: 9999px;
    box-shadow:
      0 8px 20px rgba(0, 0, 0, 0.22),
      0 0 0 3px #faf7f0;
  }

  @media (min-width: 640px) {
    .navbar-old-shell {
      padding-top: 1.35rem;
      padding-bottom: 1.35rem;
    }

    .navbar-old {
      min-height: 3.5rem;
    }

    .navbar-old-logo__img {
      width: 6rem;
      height: 6rem;
    }
  }
</style>

<script>
  import "../scripts/navbar-scroll";
</script>
