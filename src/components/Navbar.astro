---
import { Image } from "astro:assets";
import logo from "../assets/logo/logo.png";
import MobileDrawer from "./MobileDrawer.astro";

const navigation = [
  { name: "Home", href: "/#home-section" },
  { name: "About us", href: "/#about-section" },
  { name: "Rooms", href: "/#rooms-section" },
  { name: "Restaurants", href: "/#cook-section" },
  { name: "Gallery", href: "/#gallery-section" },
  { name: "Events", href: "/#events-section" },
];
---

<nav class="navbar relative">
  <div class="mx-auto max-w-7xl p-3 md:p-6 lg:px-8">
    <div class="relative flex h-12 sm:h-20 items-center">
      <div class="flex flex-1 items-center sm:justify-between">
        <!-- LOGO -->
        <div class="flex sm:hidden flex-shrink-0 items-center">
          <Image
            src={logo}
            alt="Surfing Life logo"
            width={40}
            height={40}
            format="webp"
            quality={70}
            loading="eager"
            decoding="async"
          />
          <a href="/" class="text-xl font-semibold text-black ml-4 pt-5">
            Surfing Life
            <p class="text-sm font-semibold mb-5 text-lightgrey">Guest House &amp; Restaurant</p>
          </a>
        </div>
        <div class="hidden sm:flex flex-shrink-0 items-center">
          <Image
            src={logo}
            alt="Surfing Life logo"
            width={72}
            height={72}
            format="webp"
            quality={70}
            loading="eager"
            decoding="async"
          />
          <a href="/" class="text-2xl font-semibold text-black ml-4 pt-5">
            Surfing Life
            <p class="text-lg font-semibold mb-5 text-grey">Guest House &amp; Restaurant</p>
          </a>
        </div>

        <!-- LINKS -->
        <div class="hidden lg:flex items-center">
          <div class="flex justify-end space-x-4">
            {
              navigation.map((item) => (
                <a
                  href={item.href}
                  class="navlinks px-3 py-4 rounded-md text-lg font-normal opacity-50 hover:opacity-100 hover:text-black space-links"
                >
                  {item.name}
                </a>
              ))
            }
          </div>
        </div>
        <div class="gap-6 hidden lg:flex">
          <button
            data-book-trigger
            data-room-type="Room"
            class="flex justify-end text-sm font-medium bg-pink text-white py-4 px-4 lg:px-8 rounded-full hover:bg-pink/40 transition-all duration-300 ease-in-out"
          >
            Book Now
          </button>
        </div>
      </div>

      <!-- HAMBURGER (mobile) -->
      <div class="block lg:hidden">
        <button id="drawer-trigger" aria-label="Open menu">
          <svg xmlns="http://www.w3.org/2000/svg" class="block h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</nav>

<MobileDrawer />

<script>
  import "../scripts/navbar-scroll";
</script>
