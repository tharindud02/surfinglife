---
import { Image } from "astro:assets";
import logo from "../assets/logo/logo.png";
import MobileDrawer from "./MobileDrawer.astro";

const navigation = [
  { name: "Home", href: "/#home-section" },
  { name: "About us", href: "/#about-section" },
  { name: "Rooms", href: "/#rooms-section" },
  { name: "Restaurants", href: "/#cook-section" },
  { name: "Gallery", href: "/#gallery-section" },
];
---

<nav class="navbar relative z-30 overflow-visible">
  <div class="navbar-shell mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 overflow-visible">
    <div class="navbar-row relative flex items-center overflow-visible">
      <div class="flex flex-1 items-center sm:justify-between gap-3 overflow-visible">
        <a href="/" class="navbar-logo flex flex-shrink-0 items-center gap-3 group">
          <span class="navbar-logo__hit">
            <Image
              src={logo}
              alt="Surfing Life"
              widths={[68, 80, 136, 160]}
              sizes="(min-width: 640px) 80px, 68px"
              width={80}
              height={80}
              format="webp"
              quality={72}
              loading="eager"
              decoding="async"
              class="navbar-logo__img"
            />
          </span>
          <span class="navbar-logo__text hidden sm:block self-center">
            <span class="block text-lg sm:text-xl font-semibold text-black leading-tight group-hover:text-ink transition-colors">
              Surfing Life
            </span>
            <span class="block text-[11px] sm:text-xs font-medium text-grey leading-snug">
              Guest House &amp; Restaurant
            </span>
          </span>
        </a>

        <div class="hidden lg:flex items-center">
          <div class="flex justify-end space-x-3 xl:space-x-4">
            {
              navigation.map((item) => (
                <a
                  href={item.href}
                  class="navlinks px-2 py-1.5 rounded-md text-base font-normal text-lightgrey/75 hover:text-black space-links"
                >
                  {item.name}
                </a>
              ))
            }
          </div>
        </div>

        <div class="hidden lg:flex">
          <button
            data-book-trigger
            data-room-type="Room"
            class="text-sm font-semibold bg-ink text-white py-2 px-5 xl:px-6 rounded-full hover:bg-ink/85 transition-all duration-300 ease-in-out"
          >
            Book Now
          </button>
        </div>
      </div>

      <div class="block lg:hidden shrink-0 self-center">
        <button id="drawer-trigger" aria-label="Open menu" class="p-2 -mr-1">
          <svg xmlns="http://www.w3.org/2000/svg" class="block h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</nav>

<MobileDrawer />

<style>
  /* Compact bar; logo hangs below into the page */
  .navbar-shell {
    padding-top: 0.4rem;
    padding-bottom: 0.75rem;
    overflow: visible;
  }

  .navbar-row {
    height: 2.75rem;
    overflow: visible;
  }

  .navbar-logo {
    position: relative;
    z-index: 20;
    align-self: flex-start;
    /* Hanging badge is visual-only so it doesn't steal clicks from hero CTAs */
    pointer-events: none;
  }

  .navbar-logo__hit {
    pointer-events: auto;
    display: block;
    height: 2.75rem;
    overflow: visible;
  }

  .navbar-logo__img {
    display: block;
    width: 4.25rem;
    height: 4.25rem;
    max-width: none;
    object-fit: contain;
    border-radius: 9999px;
    background-color: #ffffff;
    /* Pull bottom of badge below the thin nav strip */
    margin-bottom: -1.6rem;
    pointer-events: none;
    box-shadow:
      0 8px 20px rgba(0, 0, 0, 0.22),
      0 0 0 3px #ffffff;
  }

  .navbar-logo__text {
    pointer-events: auto;
  }

  @media (min-width: 640px) {
    .navbar-shell {
      padding-bottom: 0.9rem;
    }

    .navbar-row {
      height: 3rem;
    }

    .navbar-logo__hit {
      height: 3rem;
    }

    .navbar-logo__img {
      width: 5rem;
      height: 5rem;
      margin-bottom: -2.4rem;
    }
  }
</style>

<script>
  import "../scripts/navbar-scroll";
</script>
