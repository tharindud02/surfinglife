---
const mapSrc =
  "https://maps.google.com/maps?width=600&height=200&hl=en&q=Surfing%20Life%20Guest%20House%20Weligama&t=&z=15&ie=UTF8&iwloc=B&output=embed";
---

<div class="mapouter">
  <div class="gmap_canvas">
    <iframe
      title="Surfing Life Guest House on Google Maps"
      class="gmap_iframe"
      width="100%"
      height="200"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      allowfullscreen
      src={mapSrc}
    ></iframe>
  </div>
</div>

<style>
  .mapouter {
    position: relative;
    width: 100%;
    height: 200px;
  }
  .gmap_canvas {
    overflow: hidden;
    background: #e8e0d2;
    width: 100%;
    height: 200px;
    border-radius: 1rem;
  }
  .gmap_iframe {
    display: block;
    width: 100%;
    height: 200px !important;
    border: 0;
    border-radius: 1rem;
  }
</style>
