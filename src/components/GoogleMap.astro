---
const mapSrc =
  "https://maps.google.com/maps?q=Surfing%20Life%20Guest%20House%20Weligama&t=&z=15&ie=UTF8&iwloc=&output=embed";
const mapsLink =
  "https://www.google.com/maps/search/?api=1&query=Surfing%20Life%20Guest%20House%20Weligama";
---

<div class="mapouter">
  <div class="gmap_canvas">
    <iframe
      title="Surfing Life Guest House on Google Maps"
      class="gmap_iframe"
      width="100%"
      height="200"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      allowfullscreen
      src={mapSrc}
    ></iframe>
  </div>
  <p class="map-fallback">
    <a href={mapsLink} target="_blank" rel="noopener noreferrer">Open in Google Maps</a>
  </p>
</div>

<style>
  .mapouter {
    position: relative;
    width: 100%;
  }
  .gmap_canvas {
    overflow: hidden;
    background: #e8e0d2;
    width: 100%;
    height: 200px;
    border-radius: 1rem;
  }
  .gmap_iframe {
    display: block;
    width: 100%;
    height: 200px !important;
    border: 0;
    border-radius: 1rem;
  }
  .map-fallback {
    margin: 0.5rem 0 0;
    font-size: 0.75rem;
    text-align: right;
  }
  .map-fallback a {
    color: #6b5328;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
