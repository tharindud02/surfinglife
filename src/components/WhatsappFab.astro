---
const message =
  "Hi Eric! I'm interested in booking a room for [NUMBER_OF_NIGHTS] nights for [NUMBER_OF_PEOPLE] people. I'm also interested in learning more about your rates and availability.";
---

<div class="block lg:hidden fixed bottom-2 right-0 z-50">
  <a
    href={`https://wa.me/+94777401667?text=${encodeURIComponent(message)}`}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Chat on WhatsApp"
    class="w-16 h-16 m-3 rounded-full bg-[#25D366] flex justify-center items-center shadow-lg hover:scale-105 transition-transform duration-150"
  >
    <img
      src="/images/Navbar/whatsapp.png"
      alt=""
      width="36"
      height="36"
      loading="lazy"
      decoding="async"
    />
  </a>
</div>
