---
import { Image } from "astro:assets";
import logo from "../assets/logo/logo.png";
import GoogleMap from "./GoogleMap.astro";

const socialLinks = [
  {
    name: "Facebook",
    link: "https://facebook.com",
    icon: "facebook",
  },
  {
    name: "Instagram",
    link: "https://instagram.com",
    icon: "instagram",
  },
] as const;
---

<footer class="mx-auto max-w-2xl pt-24 px-4 sm:px-6 lg:max-w-7xl lg:px-8">
  <div class="my-12 grid grid-cols-1 gap-y-10 sm:grid-cols-6 lg:grid-cols-12">
    <div class="sm:col-span-6 lg:col-span-5">
      <div class="flex flex-shrink-0 items-center gap-4">
        <Image
          src={logo}
          alt="Surfing Life"
          widths={[80, 120, 160]}
          sizes="64px"
          width={64}
          height={64}
          format="webp"
          quality={85}
          loading="lazy"
          decoding="async"
          class="w-16 h-16 object-contain rounded-full bg-white shadow-sm ring-2 ring-white"
        />
        <a href="/" class="text-2xl font-semibold text-black">Surfing Life</a>
      </div>
      <p class="text-textbl text-sm font-medium mt-4 mb-5 max-w-sm">
        A Modern Boutique Guest House with Two Restaurants and Eight Individually Styled Rooms
      </p>
      <div class="flex items-center gap-3">
        {
          socialLinks.map((item) => (
            <a
              href={item.link}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={item.name}
              class="social-btn"
            >
              {item.icon === "facebook" ? (
                <svg class="social-btn__icon" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
                  <path d="M14 13.5h2.5l1-4H14v-2c0-1.03 0-2 2-2h1.5V2.14C17.026 2.074 15.685 2 14.29 2 11.26 2 9 3.97 9 7.29V9.5H6.5v4H9V22h5v-8.5z" />
                </svg>
              ) : (
                <svg class="social-btn__icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75">
                  <rect x="3" y="3" width="18" height="18" rx="5" />
                  <circle cx="12" cy="12" r="4" />
                  <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
                </svg>
              )}
            </a>
          ))
        }
      </div>
    </div>

    <div class="sm:col-span-6 lg:col-span-7 col-span-12 lg:justify-self-end w-full">
      <GoogleMap />
    </div>
  </div>

  <div class="py-10 md:flex items-center justify-between border-t border-t-bordertop">
    <p class="text-darkgrey text-sm text-center md:text-start font-normal">
      &copy;2026 Surfing Life. All Rights Reserved.
    </p>
    <div class="flex gap-5 mt-5 md:mt-0 justify-center md:justify-start">
      <p class="text-darkgrey text-sm font-normal">
        <a href="/privacy">Privacy policy</a>
      </p>
      <div class="h-5 bg-bordertop w-0.5" aria-hidden="true"></div>
      <p class="text-darkgrey text-sm font-normal">
        <a href="/terms">Terms &amp; Conditions</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .social-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    flex-shrink: 0;
    border-radius: 9999px;
    background: #fff;
    color: #2a2723;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.1);
    transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  .social-btn:hover {
    background: #b08d57;
    color: #fff;
    transform: translateY(-4px);
  }

  .social-btn__icon {
    width: 1.1rem;
    height: 1.1rem;
    display: block;
  }
</style>
