---
import { Image } from "astro:assets";
import Reveal from "./Reveal.astro";
import saladImg from "../assets/cook/Salad-1.png";
import burgerImg from "../assets/cook/burger-1.png";
---

<div id="cook-section" class="relative">
  <div class="absolute right-0 bottom-[-18%] hidden lg:block">
    <Image src={burgerImg} alt="" width={463} height={622} />
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 lg:items-center py-16 lg:py-20">
    <div>
      <Image
        src={saladImg}
        alt="Restaurant dish"
        width={636}
        height={808}
        class="w-full h-auto object-cover lg:rounded-r-[3rem]"
      />
    </div>

    <div class="px-6 lg:pl-12 lg:pr-[max(1.5rem,calc((100vw-80rem)/2+1.5rem))] pt-10 lg:pt-0 flex flex-col justify-center">
      <Reveal direction="up" delay={400}>
        <h2 class="text-pink text-lg font-normal mb-3 ls-51 uppercase text-start">Two Restaurants, One Address</h2>
      </Reveal>
      <Reveal direction="up" delay={800}>
        <h3 class="text-3xl lg:text-5xl font-serif font-semibold text-black text-start">Savor the Flavors</h3>
      </Reveal>
      <Reveal direction="up" delay={1000}>
        <p class="text-grey md:text-lg font-normal mb-6 text-start mt-2">
          Dining at Surfing Life is a choice, not a compromise. Our beachfront restaurant serves relaxed, all-day
          favorites and fresh seafood in an open-air setting, while our second restaurant offers a more refined
          menu of homemade and international dishes, paired with expertly crafted cocktails. Two kitchens, two
          moods, one commitment to unforgettable flavor.
        </p>
        <ul class="text-grey md:text-lg font-normal mb-8 text-start space-y-2">
          <li>— Beachfront café for casual all-day dining</li>
          <li>— Signature restaurant for elevated evening dining</li>
          <li>— Fresh seafood, homemade classics &amp; craft cocktails</li>
        </ul>
        <p class="text-grey md:text-lg font-bold mb-10 text-start mt-1">
          Come hungry, leave happy, and let the taste of Surfing Life linger in your memory.
        </p>
        <div class="flex align-middle justify-center md:justify-start">
          <button type="button" class="text-xl font-medium rounded-full text-white py-5 px-6 bg-pink lg:px-10 mr-6">
            Read more
          </button>
        </div>
      </Reveal>
    </div>
  </div>
</div>
