---
import { getImage } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Banner from "../components/Banner.astro";
import AboutTeaser from "../components/AboutTeaser.astro";
import Rooms from "../components/Rooms.astro";
import Restaurant from "../components/Restaurant.astro";
import Gallery from "../components/Gallery.astro";
import heroImage from "../assets/banner/banner-image-surf.png";

// Must match Banner.astro Image width/format/quality so preload === LCP byte.
const lcpImage = await getImage({
  src: heroImage,
  width: 800,
  height: 644,
  format: "webp",
  quality: 72,
});
---

<BaseLayout
  title="Surfing Life Guest House - Modern Luxury in Weligama, Sri Lanka"
  description="A modern boutique guest house near Coconut Beach in Weligama, Sri Lanka. Choose from eight individually styled rooms, including air-conditioned deluxe suites, and dine across two distinct restaurants. Refined comfort, steps from Sri Lanka's best surf breaks."
  lcpImageSrc={lcpImage.src}
>
  <main id="main-content">
    <Banner />
    <AboutTeaser />
    <Rooms />
    <Restaurant />
    <Gallery />
  </main>
</BaseLayout>
